# Holiday Management Backend Configuration
# Copy this file to config.env and modify as needed

# Server Settings
HOLIDAY_API_HOST=0.0.0.0
HOLIDAY_API_PORT=8000
HOLIDAY_API_DEBUG=false

# Data Settings
# Path to holidays.json (relative to backend folder)
# HOLIDAYS_FILE=data/holidays.json

# CORS Settings
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*
